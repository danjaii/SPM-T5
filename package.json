{
  "name": "spm-t5",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @spm-t5/web --filter @spm-t5/auth-service --filter @spm-t5/event-service --filter @spm-t5/venue-service --filter @spm-t5/equipment-service --filter @spm-t5/notification-service run dev",
    "env:local": "node scripts/use-env.mjs local",
    "env:hosted": "node scripts/use-env.mjs hosted",
    "check:web": "pnpm --filter @spm-t5/web run typecheck && pnpm --filter @spm-t5/web run lint && pnpm --filter @spm-t5/web run test:unit",
    "test:all": "pnpm -r --if-present run test",
    "lint:all": "pnpm -r --if-present run lint",
    "build:all": "pnpm -r --if-present run build",
    "test:mutation": "stryker run",
    "traceability": "node scripts/traceability/generate.mjs",
    "test:scripts": "node --test \"scripts/traceability/*.test.mjs\" \"scripts/e2e/*.test.mjs\"",
    "test:e2e": "pnpm --filter @spm-t5/web run test:e2e",
    "test:e2e:ui": "pnpm --filter @spm-t5/web exec playwright test --ui",
    "e2e:metrics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/generate.mjs metrics",
    "e2e:docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/generate.mjs docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "globals": "^14.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.11"
  }
}
