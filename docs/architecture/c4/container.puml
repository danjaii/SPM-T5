@startuml container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title ConnectSphere — Container Diagram (C4 Level 2)

Person(user, "User", "Organiser / Coordinator / Venue Staff / Tech Support / Attendee")

System_Boundary(connectsphere, "ConnectSphere") {
  Container(web, "Web App", "Next.js, React", "Server-rendered UI; role-based views and forms")

  Container(authSvc, "Auth Service", "Node.js/TypeScript", "Wraps Supabase Auth; issues role/permission checks; a user's own profile (view and update)")
  Container(eventSvc, "Event Service", "Node.js/TypeScript", "Event request creation, drafts, review, approval workflow, coordinator assignment, attendee registration")
  Container(venueSvc, "Venue Service", "Node.js/TypeScript", "Venue availability, booking requests, double-hold prevention, capacity checks")
  Container(equipmentSvc, "Equipment Service", "Node.js/TypeScript", "Equipment catalogue, availability checks, reservations")
  Container(notificationSvc, "Notification Service", "Node.js/TypeScript", "Sends email/SMS on status changes")

  ContainerDb(db, "Supabase Postgres", "Postgres + Row-Level Security", "Events, venues, users, roles, assignments")
  ContainerDb(storage, "Supabase Storage", "event-attachments bucket (private)", "Files attached to event comments")
}

System_Ext(supabaseAuth, "Supabase Auth", "Identity provider")
System_Ext(emailProvider, "Email/SMS Provider")

Rel(user, web, "Uses", "HTTPS")

Rel(web, authSvc, "Verifies session/role", "HTTPS/JSON")
Rel(web, eventSvc, "Create/read/update event requests; comment; assign/reassign coordinators; list upcoming events for attendees; register attendees and list registrations", "HTTPS/JSON")
Rel(web, venueSvc, "Check venues; submit, track, withdraw and amend venue booking requests", "HTTPS/JSON")
Rel(web, equipmentSvc, "Check/reserve equipment", "HTTPS/JSON")
Rel(web, storage, "Uploads and opens comment attachments through signed URLs from Event Service", "HTTPS")

Rel(authSvc, supabaseAuth, "Authenticates users", "HTTPS")
Rel(eventSvc, db, "Reads/writes", "SQL/Postgres wire protocol")
Rel(venueSvc, db, "Reads/writes", "SQL/Postgres wire protocol")
Rel(equipmentSvc, db, "Reads/writes", "SQL/Postgres wire protocol")
Rel(eventSvc, storage, "Creates signed upload/download URLs as the caller (bucket policies apply)", "HTTPS")

Rel(eventSvc, notificationSvc, "Publishes status-change events", "HTTPS/JSON or queue")
Rel(notificationSvc, emailProvider, "Sends notifications", "HTTPS/SMTP")

@enduml
