@startuml component-equipment-service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title ConnectSphere — Component Diagram: Equipment Service (C4 Level 3)
' Built so far: the equipment availability check (docs/specs/equipment-availability.md, SCRUM-18) and reserving
' equipment for an event (docs/specs/equipment-reservation.md, SCRUM-19), and coordinators requesting equipment for
' their event (docs/specs/equipment-requests.md, SCRUM-86), and Technical Support Staff reviewing those requests (SCRUM-87).
' Components marked "Planned" come with the equipment catalogue story.

Container(web, "Web App", "Next.js, React", "Check equipment availability page (/equipment-availability) and Reserve equipment page (/equipment-reservation), Technical Support Staff only; Request equipment page (/events/[id]/equipment-request) and the event page's Equipment requests section, for the event's assigned coordinator; Equipment requests queue and request pages (/equipment-requests, /equipment-requests/[id]), Technical Support Staff only")
System_Ext(supabaseAuth, "Supabase Auth", "Identity provider")
ContainerDb(db, "Supabase Postgres", "Postgres + RLS", "equipment (total_quantity, operational_status), equipment_reservations (requests too, venue_booking_id, review_reason), venue_bookings, events, users")

Container_Boundary(equipmentSvc, "Equipment Service") {
  Component(app, "App", "Express (app.ts, server.ts)", "CORS for the web app's origin (GET, POST, PATCH); injectable clock and data ports; mounts routes; error handler")
  Component(session, "Session Middleware", "middlewares/session.ts", "Reads the cs_session cookie and asks Supabase Auth who the caller is (authentication only)")
  Component(errors, "Error Handler", "middlewares/errors.ts, domain/errors.ts", "ServiceError -> 403/409/422 with a code and message; anything unexpected -> generic 500")
  Component(routes, "Equipment Routes", "routes/equipment.ts", "SCRUM-18: GET /equipment (catalogue) and GET /equipment-availability, never cached. SCRUM-19: GET /reservable-events and POST /equipment-reservations")
  Component(availabilitySvc, "Availability Service", "services/availabilityService.ts", "SCRUM-18: Technical Support Staff only (others 403); matches the name ignoring case; counts approved/reserved holds at their peak in the period; unusable equipment has none available")
  Component(reservationSvc, "Reservation Service", "services/reservationService.ts", "SCRUM-19: Technical Support Staff only (others 403); checks the input in three stages (missing, format, timing); refuses a quantity above what is free (409, nothing saved); answers with a confirmation and how many are still free")
  Component(requestRoutes, "Equipment Request Routes", "routes/equipmentRequests.ts", "SCRUM-86: GET /events/:id/equipment-request-form, GET and POST /events/:id/equipment-requests. SCRUM-87: GET /equipment-requests, GET and PATCH /equipment-requests/:id. SCRUM-88: GET /events/:id/equipment-requests/:requestId/edit-form, PATCH /events/:id/equipment-requests/:requestId")
  Component(reviewSvc, "Equipment Review Service", "services/equipmentReviewService.ts", "SCRUM-87: Technical Support Staff only (others 403); the queue of Submitted and Under Review requests, soonest event first, a changed one marked Updated (SCRUM-88); one request in full, with who last changed it; moves a waiting request to Under Review, Arranged or Cannot Fulfil (with a reason); refuses Arranged when too few units are free (409)")
  Component(requestSvc, "Equipment Request Service", "services/equipmentRequestService.ts", "SCRUM-86: only the event's assigned coordinator (others 403); not for a completed, cancelled or rejected event (409); the item must be a catalogue item that is not retired and the venue one of the event's approved bookings (422); saves as Submitted; lists the event's requests with their status, Cannot Fulfil reason, and whether the equipment is Complete (SCRUM-87/AC6, Released not counted). SCRUM-102: also equipment released with a cancelled venue booking, as Released with that venue booking's reason, and each request's venue booking id. SCRUM-88: the assigned coordinator changes a request (not a Released one, not for a finished event), with the same checks as creating it; it goes back to Submitted")
  Component(requestWriter, "Equipment Request Writer", "writers/equipmentRequestWriter.ts", "SCRUM-86: inserts a requested row into equipment_reservations as the caller; migration 25's restrictive insert policy refuses anything else. SCRUM-87: calls review_equipment_request() (migration 32), which checks the caller, the status and what is free, and saves in one step. SCRUM-88: calls update_equipment_request() (migration 33), which checks the caller is the assigned coordinator, saves the change and sends it back to Submitted in one step")
  Component(readers, "Readers", "readers/equipmentReader, reservationReader, roleReader, eventReader, venueBookingReader, equipmentRequestReader", "Read the catalogue, overlapping reservations, the caller's role, the events, an event's venue bookings and its equipment requests, as the caller, so RLS applies")
  Component(writer, "Reservation Writer", "writers/reservationWriter.ts", "Calls the reserve_equipment() database function as the caller: it locks the equipment row, re-checks availability and saves the reservation in one step, so two people cannot take the last units")
  Component(shared, "Shared Rules", "@spm-t5/shared", "parseAvailabilityInput and the reservation input checks (same prompts as the web form), Singapore time; SCRUM-86/87 equipmentRequest.ts: parseEquipmentRequestInput, parseEquipmentRequestReviewInput, statuses, readiness and the open-question rules")

  Component(catalogue, "Equipment Catalogue", "Planned", "Technical Support Staff maintain equipment and its operational status")
}

Rel(web, app, "Lists (server-side), availability checks and reservations (browser)", "HTTPS/JSON, session cookie")
Rel(app, session, "Requires a signed-in caller")
Rel(session, supabaseAuth, "Verifies session token", "HTTPS")
Rel(app, errors, "Renders failures")
Rel(app, routes, "Routes /equipment, /equipment-availability, /reservable-events and /equipment-reservations")
Rel(app, requestRoutes, "Routes /events/:id/equipment-request-form, /events/:id/equipment-requests and /equipment-requests")
Rel(requestRoutes, reviewSvc, "Queue, detail and status change")
Rel(reviewSvc, shared, "Checks the status and reason")
Rel(reviewSvc, readers, "Waiting requests, one request")
Rel(reviewSvc, requestWriter, "Changes a status")
Rel(requestRoutes, requestSvc, "Form, list, create and change")
Rel(requestSvc, shared, "Checks the input")
Rel(requestSvc, readers, "Event, catalogue, venue bookings, requests, role")
Rel(requestSvc, requestWriter, "Saves a request, or a change to one")
Rel(requestWriter, db, "Inserts into equipment_reservations (migration 25 policy); calls review_equipment_request() (migration 32) and update_equipment_request() (migration 33)", "PostgREST")
Rel(routes, availabilitySvc, "Options and check")
Rel(routes, reservationSvc, "Reservable events and reserve")
Rel(availabilitySvc, shared, "Checks the input")
Rel(availabilitySvc, readers, "Catalogue, reservations, role")
Rel(reservationSvc, shared, "Checks the input")
Rel(reservationSvc, readers, "Events, equipment, role")
Rel(reservationSvc, writer, "Reserves")
Rel(writer, db, "Calls reserve_equipment() (migration 12); inserts into equipment_reservations", "PostgREST RPC")
Rel(readers, db, "Reads equipment, equipment_reservations, venue_bookings, events, users directly (shared database, ADR 0001)", "PostgREST")

Rel(app, catalogue, "Planned")
@enduml
