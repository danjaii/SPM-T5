@startuml component-equipment-service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title ConnectSphere — Component Diagram: Equipment Service (C4 Level 3)
' Built so far: the equipment availability check (docs/specs/equipment-availability.md, SCRUM-18) and reserving
' equipment for an event (docs/specs/equipment-reservation.md, SCRUM-19).
' Components marked "Planned" come with the equipment catalogue story.

Container(web, "Web App", "Next.js, React", "Check equipment availability page (/equipment-availability) and Reserve equipment page (/equipment-reservation), Technical Support Staff only")
System_Ext(supabaseAuth, "Supabase Auth", "Identity provider")
ContainerDb(db, "Supabase Postgres", "Postgres + RLS", "equipment (total_quantity, operational_status), equipment_reservations, users")

Container_Boundary(equipmentSvc, "Equipment Service") {
  Component(app, "App", "Express (app.ts, server.ts)", "CORS for the web app's origin (GET, POST); injectable clock and data ports; mounts routes; error handler")
  Component(session, "Session Middleware", "middlewares/session.ts", "Reads the cs_session cookie and asks Supabase Auth who the caller is (authentication only)")
  Component(errors, "Error Handler", "middlewares/errors.ts, domain/errors.ts", "ServiceError -> 403/409/422 with a code and message; anything unexpected -> generic 500")
  Component(routes, "Equipment Routes", "routes/equipment.ts", "SCRUM-18: GET /equipment (catalogue) and GET /equipment-availability, never cached. SCRUM-19: GET /reservable-events and POST /equipment-reservations")
  Component(availabilitySvc, "Availability Service", "services/availabilityService.ts", "SCRUM-18: Technical Support Staff only (others 403); matches the name ignoring case; counts approved/reserved holds at their peak in the period; unusable equipment has none available")
  Component(reservationSvc, "Reservation Service", "services/reservationService.ts", "SCRUM-19: Technical Support Staff only (others 403); checks the input in three stages (missing, format, timing); refuses a quantity above what is free (409, nothing saved); answers with a confirmation and how many are still free")
  Component(readers, "Readers", "readers/equipmentReader, reservationReader, roleReader, eventReader", "Read the catalogue, overlapping reservations, the caller's role and the events, as the caller, so RLS applies")
  Component(writer, "Reservation Writer", "writers/reservationWriter.ts", "Calls the reserve_equipment() database function as the caller: it locks the equipment row, re-checks availability and saves the reservation in one step, so two people cannot take the last units")
  Component(shared, "Shared Rules", "@spm-t5/shared", "parseAvailabilityInput and the reservation input checks (same prompts as the web form), Singapore time")

  Component(catalogue, "Equipment Catalogue", "Planned", "Technical Support Staff maintain equipment and its operational status")
}

Rel(web, app, "Lists (server-side), availability checks and reservations (browser)", "HTTPS/JSON, session cookie")
Rel(app, session, "Requires a signed-in caller")
Rel(session, supabaseAuth, "Verifies session token", "HTTPS")
Rel(app, errors, "Renders failures")
Rel(app, routes, "Routes /equipment, /equipment-availability, /reservable-events and /equipment-reservations")
Rel(routes, availabilitySvc, "Options and check")
Rel(routes, reservationSvc, "Reservable events and reserve")
Rel(availabilitySvc, shared, "Checks the input")
Rel(availabilitySvc, readers, "Catalogue, reservations, role")
Rel(reservationSvc, shared, "Checks the input")
Rel(reservationSvc, readers, "Events, equipment, role")
Rel(reservationSvc, writer, "Reserves")
Rel(writer, db, "Calls reserve_equipment() (migration 12); inserts into equipment_reservations", "PostgREST RPC")
Rel(readers, db, "Reads equipment, equipment_reservations, users directly (shared database, ADR 0001)", "PostgREST")

Rel(app, catalogue, "Planned")
@enduml
