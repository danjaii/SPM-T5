@startuml component-venue-service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title ConnectSphere — Component Diagram: Venue Service (C4 Level 3)
' Built so far: the read-only venue catalogue (SCRUM-29) and the venue booking request stories
' (docs/specs/venue-booking-request.md): SCRUM-36 double-hold rule, SCRUM-32 submit, SCRUM-33 track,
' SCRUM-35 withdraw, SCRUM-60 amend, SCRUM-59 accept a suggestion, plus the Venue Staff pending queue
' (docs/specs/venue-booking-approval.md, SCRUM-37), and several venue bookings per event (SCRUM-98,
' docs/specs/multiple-venue-bookings.md), and changing or cancelling one of them (SCRUM-102,
' docs/specs/change-cancel-venue-booking.md). Components marked "Planned" come
' with the availability calendar, suitability and the Venue Staff decision stories (SCRUM-38 to 40).

Container(web, "Web App", "Next.js, React", "Venue catalogue (/venues, /venues/[id]); venue search (/venues/search); venue booking request form and my-bookings list/detail; an event's venue bookings on its page")
System_Ext(supabaseAuth, "Supabase Auth", "Identity provider")
ContainerDb(db, "Supabase Postgres", "Postgres + RLS", "venue_bookings (overlap exclusion constraint, one active replacement per rejected request, one suggestion acceptance), venues, room_layouts, facilities, events, users")

Container_Boundary(venueSvc, "Venue Service") {
  Component(app, "App", "Express (app.ts, server.ts)", "JSON body parsing; CORS for the web app's origin (GET, POST, PUT); injectable clock and data ports; mounts routes; error handler")
  Component(session, "Session Middleware", "middlewares/session.ts", "Reads the cs_session cookie and asks Supabase Auth who the caller is (authentication only)")
  Component(errors, "Error Handler", "middlewares/errors.ts, domain/errors.ts", "BookingError -> 409/403/404/422 with only a code and message; anything unexpected -> generic 500, so a refusal never exposes another event")
  Component(catalogue, "Venue Catalogue Routes", "routes/venues.ts", "SCRUM-29: coordinators + venue staff only, others 403. GET /venues, GET /venues/:id (layouts, facilities)")
  Component(bookingRoutes, "Booking Routes", "routes/venueBookings.ts", "POST /venue-bookings, GET /venue-bookings (+ /:id), withdraw / amend / accept-suggestion, GET /events/:id/venue-booking-form, GET /events/:id/venue-bookings (SCRUM-98), PATCH /venue-bookings/:id and POST /venue-bookings/:id/cancel (SCRUM-102)")
  Component(bookingSvc, "Booking Service", "services/bookingService.ts", "Submit, amend and accept-suggestion through one path; withdraw (SCRUM-32/35/60/59). SCRUM-98: several venue bookings per event, DUPLICATE_VENUE for the same venue overlapping, each booking's own attendance and requirements, capacity warning. SCRUM-102: change one (back to PENDING, NO_CHANGES, NOT_ACTIVE) or cancel it with a reason, only by the event's current coordinator. SCRUM-110: submit and change run the shared suitability check on the booking's own attendance and requirements after the slot check; an unsuitable venue needs a reason (409 UNSUITABLE_VENUE otherwise) and the result is stored with the booking")
  Component(trackingSvc, "Tracking Service", "services/trackingService.ts", "SCRUM-33: the coordinator's requests, detail, rejection reason, suggestion, amendment chain. SCRUM-98: every venue booking of one event")
  Component(queueRoutes, "Booking Queue Routes", "routes/bookingQueue.ts", "SCRUM-37: GET /booking-queue and /booking-queue/:id, Venue Staff only (others 403), never cached")
  Component(queueSvc, "Queue Service", "services/queueService.ts", "SCRUM-37: pending requests oldest first (created_at, then id) with the snapshotted event details and requester name; detail shows who decided, when and why")
  Component(slotRule, "Slot Conflict Rule", "services/slotConflictRule.ts", "SCRUM-36: friendly pre-check that a venue period is not held by a Pending/Approved request")
  Component(repo, "Booking Repository", "repositories/supabaseBookingRepository.ts", "Inserts requests; conditional withdraw/decide updates; turns constraint violations into SLOT_CONFLICT / ACTIVE_REQUEST_EXISTS / SUGGESTION_ALREADY_USED; retries a deadlock victim. SCRUM-102: change and cancel through change_venue_booking() and cancel_venue_booking() (migration 30), whose refusals become FORBIDDEN / EVENT_NOT_ELIGIBLE")
  Component(readers, "Readers", "readers/eventReader, venueReader, roleReader", "Read events (DR16), venue names and the caller's role as the caller, so RLS applies")
  Component(userReader, "User Reader", "readers/userReader.ts", "SCRUM-37: full names for the requester and the deciding Venue Staff member")
  Component(shared, "Shared Rules", "@spm-t5/shared", "Roles, period overlap, Singapore time, status mapping, error codes, input validation — same rules the web app uses")

  Component(decisionRoutes, "Decision Routes", "routes/venueBookings.ts", "SCRUM-38/39: POST /venue-bookings/:id/approve and /reject, GET /events/:id/venue-booking; Venue Staff decide, only the assigned Coordinator reads the event booking")
  Component(decisionSvc, "Decision Service", "services/decisionService.ts", "SCRUM-38/39: Venue Staff approve or reject a pending request (409 NOT_PENDING once decided, SLOT_IN_PAST, reason 1-500 chars); the event's approved venue for its Coordinator. SCRUM-40 adds the suggestion later")
  Component(searchRoutes, "Venue Search Routes", "routes/venues.ts", "SCRUM-65: GET /venues/search (date, start, end, plus attendance, location, layout, accessibility, facilities) and GET /venues/search-options; coordinators and venue staff only; validation shared with the web form")
  Component(searchSvc, "Venue Search Service", "services/venueSearchService.ts, readers/venueSearchReader.ts", "SCRUM-65: venues free for the period (available_venues) that meet every criterion given: capacity >= attendance (the layout's own capacity when a layout is chosen), location, accessibility, layout, all facilities")
  Component(suitabilityRoutes, "Suitability Routes", "routes/suitability.ts", "SCRUM-109: GET /venue-suitability?venueId&eventId (optional date, times, attendance); coordinators and venue staff only, others 403")
  Component(suitabilitySvc, "Suitability Service", "services/suitabilityService.ts, services/availabilityLookup.ts, readers/venueDetailsReader.ts", "SCRUM-109: reads the venue and event as the caller and runs the shared checkSuitability (capacity, layout, accessibility, facilities, operating hours, availability); availability goes through one lookup seam")
  Component(timing, "Venue Timing", "routes/venues.ts, readers/venueTimingWriter.ts", "SCRUM-101: PUT /venues/:id/timing (Venue Staff only, 403 first, then shared validation) saves the venue's setup and turnaround minutes through set_venue_timing; GET /venues/:id returns them with can_edit_timing")
  Component(padded, "Padded Occupancy", "services/slotConflictRule.ts, routes/venues.ts, packages/shared venueOccupancy.ts", "SCRUM-103: a booking occupies its venue from its setup to the end of its turnaround; the conflict check names the occupied period (findConflict), GET /venues/:id/availability?date= shows each booking as Setup, Event and Turnaround; applies to submit, amend, accept-suggestion and change")
  Component(availability, "Availability Calendar", "Planned", "Bookings, tentative holds, maintenance blocks, shown as a calendar")
}

Rel(web, app, "Catalogue and booking requests (server-side and browser)", "HTTPS/JSON, session cookie")
Rel(app, session, "Requires a signed-in caller")
Rel(session, supabaseAuth, "Verifies session token", "HTTPS")
Rel(app, errors, "Renders failures")
Rel(app, catalogue, "Routes /venues requests")
Rel(app, bookingRoutes, "Routes booking requests")
Rel(catalogue, shared, "Checks the caller's role")
Rel(app, queueRoutes, "Routes /booking-queue requests")
Rel(bookingRoutes, bookingSvc, "Submit, withdraw, amend, accept")
Rel(bookingRoutes, trackingSvc, "List and detail")
Rel(queueRoutes, queueSvc, "List and detail")
Rel(decisionRoutes, decisionSvc, "Approve, reject, event booking")
Rel(decisionSvc, repo, "Reads the request; conditional decide")
Rel(decisionSvc, readers, "Event and venue lookups")
Rel(queueSvc, repo, "Reads pending requests")
Rel(queueSvc, readers, "Venue names")
Rel(queueSvc, userReader, "Requester and decider names")
Rel(userReader, db, "Reads users.full_name", "PostgREST")
Rel(bookingSvc, slotRule, "Checks the slot before inserting")
Rel(bookingSvc, repo, "Reads history, inserts, withdraws")
Rel(bookingSvc, readers, "Event, venue and role lookups")
Rel(trackingSvc, repo, "Reads requests")
Rel(trackingSvc, readers, "Assigned events, venue names")
Rel(slotRule, repo, "Asks whether the period is held")
Rel(repo, shared, "Status values, holding statuses")
Rel(repo, db, "Reads/writes venue_bookings; the database constraint is the atomic guarantee", "PostgREST")
Rel(repo, db, "SCRUM-102: change_venue_booking() and cancel_venue_booking() update the venue booking and its equipment_reservations in one step", "PostgREST RPC")
Rel(readers, db, "Reads events, venues, users directly (shared database, ADR 0001)", "PostgREST")
Rel(catalogue, db, "Reads venues with layouts and facilities", "PostgREST")

Rel(app, decisionRoutes, "Routes approve and reject")
Rel(app, searchRoutes, "Routes venue search requests")
Rel(searchRoutes, searchSvc, "Searches")
Rel(searchSvc, db, "available_venues() (security definer, migration 13) for free venues; venues with layouts and facilities for the filters", "PostgREST RPC")
Rel(searchRoutes, shared, "parseVenueSearchInput")
Rel(app, suitabilityRoutes, "Routes suitability checks")
Rel(suitabilityRoutes, suitabilitySvc, "Checks a venue against an event")
Rel(bookingSvc, suitabilitySvc, "Reads the venue with layouts and hours; runs checkSuitability (SCRUM-110)")
Rel(suitabilitySvc, repo, "Is the venue held for the period? (venue_slot_is_held)")
Rel(suitabilitySvc, shared, "checkSuitability, isOpenDuring")
Rel(suitabilitySvc, db, "Reads the event and the venue with layouts and hours as the caller", "PostgREST")
Rel(app, timing, "Routes venue timing edits")
Rel(timing, db, "set_venue_timing() (security definer, migration 26) is the only writer of venues.setup_minutes / turnaround_minutes", "PostgREST RPC")
Rel(timing, shared, "parseVenueTimingInput, canEditVenueTiming")
Rel(app, padded, "Routes availability requests; the slot rule runs inside the booking service")
Rel(padded, db, "venue_slot_conflicts() / venue_occupied_periods() (security definer, migration 27); the padded-overlap trigger replaces venue_bookings_no_overlap and is the atomic guarantee", "PostgREST RPC")
Rel(app, availability, "Planned")
@enduml
