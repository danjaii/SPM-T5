@startuml component-notification-service
!include <C4/C4_Component>

title ConnectSphere — Component Diagram: Notification Service (C4 Level 3)
' Built so far: viewing and managing a user's own in-app notifications (docs/specs/notifications.md, SCRUM-46), acknowledging
' an on-site assignment (SCRUM-20), and the periodic hold expiry check (SCRUM-108, docs/specs/SCRUM-97-108-tentative-hold-expiry.md).
' Rows are written by producers, not by this service (ADR 0002): triggers and security definer functions in migrations 41, 44,
' 46, 50, 65, 69, 80, 82, 83, 87 and 88. The one exception is notify_hold_expiries() (migration 88), which this service calls
' every minute because a hold expiring is a moment in time, not a change anyone makes.
' Notifications are in-app only: email and SMS are not part of this project (docs/scope-decisions.md).

Container(web, "Web App", "Next.js, React", "Notifications page (/notifications) and the notification bell in the sidebar, with the unread count")
System_Ext(supabaseAuth, "Supabase Auth", "Identity provider")
ContainerDb(db, "Supabase Postgres", "Postgres + RLS", "notifications (own rows only: migration 35), technical_staff_assignments, events, venue_bookings (hold_expires_at, hold_warning_minutes and the two sent flags, migrations 87 and 88), users")

Container_Boundary(notificationSvc, "Notification Service") {
  Component(app, "App", "Express (app.ts, server.ts)", "CORS for the web app's origin (GET, POST, credentials); injectable repository and access reader; /health; mounts /notifications behind the session check; error handler. server.ts also starts the hold expiry check")
  Component(session, "Session Middleware", "middlewares/session.ts", "Reads the cs_session cookie and asks Supabase Auth who the caller is (authentication only)")
  Component(errors, "Error Handler", "middlewares/errors.ts, domain/errors.ts", "NotificationError -> 404/422 with a code and message; anything unexpected -> generic 500")
  Component(routes, "Notification Routes", "routes/notifications.ts", "GET /notifications?limit= (newest first, with unreadCount), GET /notifications/unread-count, POST /notifications/:id/read (422 for a bad id). SCRUM-20: POST /notifications/:id/acknowledge")
  Component(svc, "Notification Service", "services/notificationService.ts", "Turns rows into items with the related event or booking and its page; marks read idempotently; a target the caller can no longer see gets no link and the no-access wording (AC5, AC7). SCRUM-20: an on-site assignment notification says whether it can still be acknowledged (only the one about the current details, while the assignment is active) and when it was")
  Component(repo, "Notification Repository", "repositories/supabaseNotificationRepository.ts", "Lists, counts, finds and marks read the caller's rows, as the caller, so RLS applies; only is_read can be written. SCRUM-20: reads the technician's assignments and calls acknowledge_technical_assignment() (migration 41)")
  Component(access, "Access Reader", "readers/accessReader.ts", "Looks up the caller's role and the names of the events and venue bookings they can still see, as the caller")
  Component(shared, "Shared Rules", "@spm-t5/shared notifications.ts", "NotificationItem, the notification types (including venue_block_lifted, event_returned_to_planning, arrangements_reconfirmed and the hold expiry notices), notificationHref (an attendee's event notification opens /registrations, SCRUM-172), NO_ACCESS_LABEL, parseNotificationLimit")

  Component(holdCheck, "Hold Expiry Check", "services/holdExpiryCheck.ts", "SCRUM-108: every minute, one pass of notify_hold_expiries(now). A failed pass is logged and the next still runs; a pass still running when the timer fires is not doubled up. Not started when SUPABASE_SECRET_KEY is unset")
  Component(admin, "Hold Check Client", "supabase.ts createHoldExpiryDb (secret key)", "Bypasses RLS. Used only by the hold expiry check, because notify_hold_expiries() writes notifications for other people and only the service role may call it")
}

Rel(web, app, "Lists (server-side); marks read and acknowledges (browser)", "HTTPS/JSON, session cookie")
Rel(app, session, "Requires a signed-in caller")
Rel(session, supabaseAuth, "Verifies session token", "HTTPS")
Rel(app, errors, "Renders failures")
Rel(app, routes, "Routes /notifications")
Rel(routes, svc, "List, count, mark read, acknowledge")
Rel(routes, shared, "Parses the limit")
Rel(svc, shared, "Maps a target to its page")
Rel(svc, repo, "Own notifications")
Rel(svc, access, "What the caller can still see")
Rel(repo, db, "Selects and updates notifications (migration 35 policies and grants); acknowledges assignments (migration 41)", "PostgREST")
Rel(access, db, "Reads users, events, venue_bookings (their RLS applies)", "PostgREST")

Rel(app, holdCheck, "Starts on boot (server.ts)")
Rel(holdCheck, admin, "Runs each pass")
Rel(admin, db, "notify_hold_expiries() (security definer, migration 88): writes each 'expires soon' and 'expired' notice once for the event's coordinator and sets its sent flag", "PostgREST RPC")
Rel(db, repo, "Producers' triggers write the rows this service serves (ADR 0002)", "Shared database")
@enduml
